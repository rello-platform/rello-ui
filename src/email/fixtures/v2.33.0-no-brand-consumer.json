    "html": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"x-apple-disable-message-reformatting\"><title>Your plan is ready, Sarah</title></head><body style=\"margin:0;padding:24px 12px;background:#eef1f5;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#1f2937;\"><div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#eef1f5;opacity:0;\">Tap to see where you stand.</div><!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\"><tr><td><![endif]--><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:10px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;\"><tr><td align=\"center\" bgcolor=\"#2d6a4f\" style=\"background:#2d6a4f;padding:30px 32px 26px;color:#ffffff;border-radius:10px 10px 0 0;\"><div style=\"font-size:22px;font-weight:700;color:#ffffff;margin:0 0 10px;\">Home Scout</div><div style=\"font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#ffffff;\">Home Scout · from ClearPath Utah Mortgage</div><div style=\"font-size:25px;font-weight:700;margin-top:10px;line-height:1.25;color:#ffffff;\">Your plan is ready, Sarah.</div></td></tr><tr><td style=\"padding:24px 32px 0;\"><span style=\"display:inline-block;background:#f7efdf;color:#83682f;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:4px 10px;border-radius:999px;\">New</span><div style=\"font-size:14px;color:#546b5f;margin-top:8px;\">4 minutes ago · from your page</div></td></tr><tr><td style=\"padding:24px 32px 4px;font-size:16px;line-height:1.6;color:#1f2937;\"><p style=\"margin:0 0 12px;\">I put together your plan.</p><p style=\"margin:0 0 0;\">It takes about 2 minutes.<br>No password needed.</p></td></tr><tr><td style=\"padding:18px 32px 4px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f5f2;border:1px solid #e2e0da;border-radius:8px;font-size:14px;line-height:1.5;\"><tr><td colspan=\"2\" style=\"padding:14px 18px 2px;font-weight:700;color:#111827;\">Your numbers</td></tr><tr><td valign=\"top\" style=\"padding:8px 18px 14px;color:#546b5f;width:130px;\">Budget</td><td valign=\"top\" style=\"padding:8px 18px 14px;color:#111827;\">$450,000</td></tr></table></td></tr><tr><td align=\"center\" style=\"padding:24px 32px 6px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 auto;\"><tr><td align=\"center\" bgcolor=\"#2d6a4f\" style=\"background:#2d6a4f;border-radius:8px;\"><a href=\"https://example.com/plan?a=1&amp;b=2\" style=\"display:inline-block;background:#2d6a4f;color:#ffffff;text-decoration:none;font-weight:600;font-size:16px;line-height:20px;padding:14px 32px;border-radius:8px;\">See my plan</a></td></tr></table><div style=\"margin-top:12px;font-size:15px;\"><a href=\"https://example.com/talk\" style=\"color:#2d6a4f;font-weight:600;text-decoration:none;\">Talk to me</a></div><div style=\"font-size:13px;color:#546b5f;margin-top:10px;\">This link expires in 7 days.</div></td></tr><tr><td style=\"padding:16px 32px 4px;font-size:13px;line-height:1.6;color:#546b5f;\">Button not working? Copy this link into your browser:<br><a href=\"https://example.com/plan?a=1&amp;b=2\" style=\"color:#2d6a4f;word-break:break-all;\">https://example.com/plan?a=1&amp;b=2</a></td></tr><tr><td style=\"padding:20px 32px 22px;font-size:15px;line-height:1.6;color:#1f2937;\"><p style=\"margin:0 0 12px;\">Reply any time.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td width=\"52\" valign=\"top\"><div style=\"width:40px;height:40px;border-radius:20px;background:#e0e9e5;text-align:center;line-height:40px;font-size:14px;font-weight:700;color:#2d6a4f;\">KS</div></td><td valign=\"top\" style=\"font-size: